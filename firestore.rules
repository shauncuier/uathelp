rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In this architecture, roles are managed via Custom Claims.
      // Alternatively, we can check the users collection if needed.
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // All writes are handled securely by the Next.js Backend (Admin SDK)
    // which bypasses these rules entirely. We just need to allow public reads
    // for relevant collections.
    
    match /notices/{noticeId} {
      // Anyone can read published notices. Backend handles draft visibility.
      allow read: if true;
      allow write: if false; 
    }
    
    match /universities/{uniId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other client access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
